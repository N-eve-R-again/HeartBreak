{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0905177c2b374cdfa9e46453251cd224",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetCameraFov (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1681.9998779296875,
            "y": 1008.9999389648438,
            "width": 239.0,
            "height": 118.00006103515625
        }
    },
    "m_Slots": [
        {
            "m_Id": "d9e01d9b86124b5197255be3b1571d8f"
        },
        {
            "m_Id": "cc2090bb44534b0280284d8b0cfaf823"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetCameraFov",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// m11 correspond à l'élément (1,1) de la matrice de projection perspective\nfloat m11 = unity_CameraProjection._m11;\nfloat m00 = unity_CameraProjection._m00;\n\n// Calcul du FOV en radians\nfloat fovRadV = 2.0 * atan(1.0 / abs(m11));\nfloat fovRadH = 2.0 * atan(1.0 / abs(m00));\n\n// Conversion en degrés (180 / PI)\nVerticalFOV = fovRadV * 57.2957795;\nHorizontalFOV = fovRadH * 57.2957795;"
}

