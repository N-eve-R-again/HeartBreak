{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d8a154ceca464c419876bc8b59796af8",
    "m_Title": "Réglages du target",
    "m_Content": "Unlit + Keep Lighting Variants = ombres et lumières additionnelles dispo dans le HLSL, sans le PBR d'URP.\nDefault SSAO décoché (sinon l'AO assombrirait aussi les reflets). Decals : laissés actifs.\nResinLighting.hlsl doit être dans le projet (le .meta garde le lien).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 10450.0,
        "y": -280.0,
        "width": 560.0,
        "height": 190.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d8f29f4e160c42cdaa0677af5e62760f",
    "m_Title": "Irisation + paillettes",
    "m_Content": "Gradient échantillonné par l'angle de vue (Fresnel puissance 1) = couleur iridescente.\nSpéculaire × irisation × IredecentSpecular.\nSparkle × masque sparkles × irisation × Intensité paillettes.",
