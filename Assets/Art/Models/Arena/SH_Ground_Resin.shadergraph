{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cfef48f7ae104f3fa18334b457370dfe",
    "m_Title": "Éclairage (HLSL : ResinLighting.hlsl)",
    "m_Content": "Une seule boucle : lumière principale + toutes les additionnelles (Forward+ OK).\nDiffuse = Lambert, Specular = GGX net (surface vernie), Sparkle = lobe large pour les paillettes.\nBaked GI = lightmaps / light probes.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 4390.0,
