{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cd48c3c79fbd48d69e3650fa57a1e037",
    "m_Title": "Mosaïque polaire",
    "m_Content": "Anneaux autour du centre de l'arène (= pivot des meshes, nœud Object), découpés en arcs.\nChaque arc lit la RT et la probe en UN seul point -> aplats allongés, fixes dans le monde.\nScreenUV -> UV de la RT, ReflectDir -> probe, Random -> variation de luminosité par arc.\nMosaïque = 0 : reflet normal. Le motif s'efface tout seul quand les bandes deviennent trop fines.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 6158.0,
        "y": 4713.0,
        "width": 620.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": "5d4e1649b80348679da33565659bbf39"
    }
}

